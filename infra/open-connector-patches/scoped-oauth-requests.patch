diff --git a/src/server/api/connection-routes.test.ts b/src/server/api/connection-routes.test.ts
index 05218464..a110d122 100644
--- a/src/server/api/connection-routes.test.ts
+++ b/src/server/api/connection-routes.test.ts
@@ -409,3 +409,57 @@ it("connects Slack using granted scopes from the nested user token response", as
   expect(connection.scopes).toEqual(["channels:read", "users:read"]);
   expect(fetcher).toHaveBeenCalledTimes(2);
 });
+
+describe("scoped OAuth requests", () => {
+  it("separates concurrent authorizations and cancels only the selected scope", async () => {
+    const { app, call, database } = await setup(undefined, { adminToken: "admin", runtimeToken: "runtime" });
+    const scoped = (path: string, scope: string, method = "GET", body?: unknown) =>
+      app.request(path, {
+        method,
+        headers: { authorization: "Bearer admin", "content-type": "application/json", "x-oo-connection-scope": scope },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+    const first = (await (await scoped("/v1/connections/example/connect", "team-one", "POST", {})).json()).data;
+    const second = (await (await scoped("/v1/connections/example/connect", "team-two", "POST", {})).json()).data;
+    const firstPath = `/v1/connection-requests/${first.connectionRequestId}`;
+    const secondPath = `/v1/connection-requests/${second.connectionRequestId}`;
+    expect((await scoped(firstPath, "team-two")).status).toBe(404);
+    await scoped(firstPath, "team-two", "DELETE");
+    expect((await (await scoped(firstPath, "team-one")).json()).data.status).toBe("initiated");
+    await scoped(firstPath, "team-one", "DELETE");
+    expect((await call(`/oauth/callback?state=${first.stateHandle}&code=code`)).status).not.toBe(200);
+    expect((await call(`/oauth/callback?state=${second.stateHandle}&code=code`)).status).toBe(200);
+    expect((await (await scoped(secondPath, "team-two")).json()).data.status).toBe("connected");
+    expect(await database.connectionStore.list()).toHaveLength(1);
+    expect((await call("/v1/connection-capabilities", undefined, "runtime")).status).toBe(401);
+    expect((await (await call("/v1/connection-capabilities")).json()).data).toEqual({
+      scopedRequests: true,
+      cancelRequests: true,
+    });
+  });
+  it("prevents an in-flight token exchange from recreating a cancelled account", async () => {
+    let release!: () => void;
+    let started!: () => void;
+    const entered = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    const gate = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const { app, database, call } = await setup(async () => {
+      started();
+      await gate;
+      return { accessToken: "fake-access", tokenType: "Bearer", metadata: {} };
+    });
+    const headers = { "content-type": "application/json", "x-oo-connection-scope": "account-one" };
+    const request = (
+      await (await app.request("/v1/connections/example/connect", { method: "POST", headers, body: "{}" })).json()
+    ).data;
+    const callback = call(`/oauth/callback?state=${request.stateHandle}&code=code`);
+    await entered;
+    await app.request(`/v1/connection-requests/${request.connectionRequestId}`, { method: "DELETE", headers });
+    release();
+    await callback;
+    expect(await database.connectionStore.list()).toHaveLength(0);
+  });
+});
