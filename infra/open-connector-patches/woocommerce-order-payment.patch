@@ -0,0 +1,68 @@
+import type { Schema } from "@cfworker/json-schema";
+
+import { Validator } from "@cfworker/json-schema";
+import { describe, expect, it } from "vitest";
+import { getProviderActionHandler } from "../provider-runtime.ts";
+import { provider } from "./definition.ts";
+import { resolveWooCommerceCredentialContext, woocommerceActionHandlers } from "./runtime.ts";
+
+describe("WooCommerce order payment facts", () => {
+  it.each(["list_orders", "get_order", "create_order", "update_order", "update_order_status"])(
+    "%s preserves the provider's payment facts and satisfies its output contract",
+    async (name) => {
+      const payload = {
+        id: 17,
+        status: "processing",
+        payment_url: "https://store.example.test/checkout/order-pay/17/?key=fixture-only",
+        needs_payment: false,
+        payment_method: "bacs",
+        payment_method_title: "Bank transfer",
+        transaction_id: "fixture-transaction",
+        date_paid: "2026-09-18T15:00:00",
+        date_paid_gmt: "2026-09-18T08:00:00",
+      };
+      const context = resolveWooCommerceCredentialContext(
+        { storeUrl: "https://store.example.test", consumerKey: "fixture-key", consumerSecret: "fixture-secret" },
+        async () => Response.json(name === "list_orders" ? [payload] : payload),
+      );
+      const output = await getProviderActionHandler(woocommerceActionHandlers, name)!(
+        { orderId: 17, status: "processing", lineItems: [{ productId: 7, quantity: 1 }] },
+        context,
+      );
+      const action = provider.actions.find((item) => item.name === name)!;
+      expect(new Validator(action.outputSchema as Schema).validate(output)).toMatchObject({ valid: true });
+      const expected = {
+        paymentUrl: payload.payment_url,
+        needsPayment: false,
+        paymentMethod: "bacs",
+        paymentMethodTitle: "Bank transfer",
+        transactionId: "fixture-transaction",
+        datePaid: "2026-09-18T15:00:00",
+        datePaidGmt: "2026-09-18T08:00:00",
+      };
+      expect(output).toMatchObject(name === "list_orders" ? { orders: [expected] } : expected);
+    },
+  );
+
+  it.each([
+    { status: "pending", needs_payment: true },
+    { status: "on-hold", needs_payment: false },
+    { status: "cancelled", needs_payment: false },
+    { status: "completed" },
+  ])("does not infer payment from status $status or a missing field", async (payload) => {
+    const context = resolveWooCommerceCredentialContext(
+      { storeUrl: "https://store.example.test", consumerKey: "fixture-key", consumerSecret: "fixture-secret" },
+      async () => Response.json(payload),
+    );
+    expect(await woocommerceActionHandlers.get_order({ orderId: 17 }, context)).toMatchObject({
+      status: payload.status,
+      needsPayment: payload.needs_payment ?? null,
+      paymentUrl: null,
+      paymentMethod: null,
+      paymentMethodTitle: null,
+      transactionId: null,
+      datePaid: null,
+      datePaidGmt: null,
+    });
+  });
+});
