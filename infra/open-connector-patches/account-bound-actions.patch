+describe("account-bound HTTP actions", () => {
+  async function fixture() {
+    const store = new MemoryConnectionStore();
+    const execute = vi.fn<ActionExecutor>(async (input) => ({ ok: true, output: input }));
+    const app = createTestServer([{ ...apiKeyProvider, actions: [echoAction] }], {
+      providerLoader: new ActionProviderLoader(execute),
+      connectionStore: store,
+      auth: { adminToken: "synthetic-admin", runtimeToken: "synthetic-runtime" },
+    }).createApp();
+    const response = await app.request("/api/connections/example", {
+      method: "PUT",
+      headers: { authorization: "Bearer synthetic-admin", "content-type": "application/json" },
+      body: JSON.stringify({ authType: "api_key", values: { apiKey: "synthetic-key" } }),
+    });
+    expect(response.status).toBe(200);
+    const connection = (await response.json()) as { profile: { accountId: string } };
+    const send = (account: string, key?: string, authorization = "Bearer synthetic-runtime") =>
+      app.request(`/v1/actions/example.echo/for-account/${encodeURIComponent(account)}`, {
+        method: "POST",
+        headers: { authorization, "content-type": "application/json", ...(key ? { "Idempotency-Key": key } : {}) },
+        body: JSON.stringify({ input: { message: "synthetic" } }),
+      });
+    return { app, execute, send, store, account: connection.profile.accountId };
+  }
+  it("dispatches only for the expected account and fingerprints it for idempotency", async () => {
+    const f = await fixture();
+    expect((await f.send(f.account, "same-key")).status).toBe(200);
+    expect((await f.send(f.account, "same-key")).status).toBe(200);
+    const conflict = await f.send("different-account", "same-key");
+    expect(conflict.status).toBe(409);
+    expect(await conflict.json()).toMatchObject({ errorCode: "idempotency_key_conflict" });
+    expect(f.execute).toHaveBeenCalledOnce();
+  });
+  it("rejects a changed account without idempotency before the provider action", async () => {
+    const f = await fixture();
+    const response = await f.send("different-account");
+    expect(response.status).toBe(409);
+    expect(await response.json()).toMatchObject({ errorCode: "connection_changed", meta: { dispatch: "not_started" } });
+    expect(f.execute).not.toHaveBeenCalled();
+  });
+  it("replays historical results after reauthorization but rejects fresh sends for the old account", async () => {
+    const f = await fixture();
+    const first = await (await f.send(f.account, "completed-key")).json();
+    const previous = await f.store.get("example", "default");
+    if (previous?.credential.authType !== "api_key") throw new Error("Expected API key credential");
+    await f.store.set("example", "default", {
+      ...previous!.credential,
+      profile: { ...previous!.credential.profile, accountId: "replacement" },
+    });
+    expect(await (await f.send(f.account, "completed-key")).json()).toEqual(first);
