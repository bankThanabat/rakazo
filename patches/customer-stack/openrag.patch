+from fastapi import Depends, HTTPException
 from pydantic import BaseModel, Field
 
-from dependencies import require_api_key_permission
+from dependencies import (
+    require_api_key_permission,
+    get_knowledge_filter_service,
+    get_search_service,
+)
+from api.v1._filter_resolution import resolve_filter_id
+from api.v1.search import SearchV1Body, search_endpoint
 from services.customer_flows import publish_customer_flow
+from services.rbac_service import is_rbac_enforced
 from session_manager import User
 
 
 class CustomerFlowBody(BaseModel):
     staff_id: str = Field(min_length=1, max_length=200)
     instructions: str = Field(min_length=1, max_length=32000)
+    knowledge_filter_id: str | None = None
+
+
+def require_customer_rbac():
+    if not is_rbac_enforced():
+        raise HTTPException(status_code=503, detail="Customer support requires RBAC enforcement")
+
+
+async def approved_filter(filter_id, service, user):
+    resolved = await resolve_filter_id(
+        filter_id, service, user_id=user.user_id, jwt_token=user.jwt_token
+    )
+    # A saved filter must choose concrete sources. Empty/wildcard dimensions are not publication.
+    if not resolved["filters"].get("data_sources"):
+        raise HTTPException(status_code=422, detail="Select explicit customer knowledge sources")
+    return resolved
+
+
+async def search_customer_endpoint(
+    body: SearchV1Body,
+    user: User = Depends(require_api_key_permission("search:use")),
+    knowledge_filter_service=Depends(get_knowledge_filter_service),
+    search_service=Depends(get_search_service),
+):
+    require_customer_rbac()
+    if not body.filter_id:
+        raise HTTPException(status_code=422, detail="Approved knowledge is required")
+    resolved = await approved_filter(body.filter_id, knowledge_filter_service, user)
+    return await search_endpoint(
+        SearchV1Body(
+            query=body.query,
+            filters=resolved["filters"],
+            limit=min(resolved["limit"], 10),
+            score_threshold=resolved["score_threshold"],
+        ),
+        search_service=search_service,
+        user=user,
+        knowledge_filter_service=knowledge_filter_service,
+    )
 
 
 async def publish_endpoint(
-    body: CustomerFlowBody, user: User = Depends(require_api_key_permission("flows:edit"))
+    body: CustomerFlowBody,
+    user: User = Depends(require_api_key_permission("flows:edit")),
+    knowledge_filter_service=Depends(get_knowledge_filter_service),
 ):
     """Provision a staff-associated flow using only the shipped customer template."""
+    require_customer_rbac()
+    if body.knowledge_filter_id:
+        await approved_filter(body.knowledge_filter_id, knowledge_filter_service, user)
     flow_id = await publish_customer_flow(user.user_id, body.staff_id, body.instructions)
     return {"flow_id": flow_id}
