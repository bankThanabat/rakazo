@@ -0,0 +1,165 @@
+import type { ProviderActionDefinition } from "../../core/provider-definition.ts";
+import type { JsonSchema } from "../../core/types.ts";
+
+import { s } from "../../core/json-schema.ts";
+import { defineProviderAction } from "../../core/provider-definition.ts";
+
+const cartToken = s.nonEmptyString(
+  "Secret Store API cart capability. Keep server-side and scoped to one shopper and purchase; never log or publish it.",
+  { maxLength: 8192 },
+);
+const address = s.object(
+  "Shopper-supplied Store API address. WooCommerce validates required fields.",
+  Object.fromEntries(
+    [
+      "first_name",
+      "last_name",
+      "company",
+      "address_1",
+      "address_2",
+      "city",
+      "state",
+      "postcode",
+      "country",
+      "email",
+      "phone",
+    ].map((key) => [key, s.string(key, { maxLength: 500 })]),
+  ),
+  {
+    optional: [
+      "first_name",
+      "last_name",
+      "company",
+      "address_1",
+      "address_2",
+      "city",
+      "state",
+      "postcode",
+      "country",
+      "email",
+      "phone",
+    ],
+  },
+);
+const quantity = s.positiveInteger("Requested quantity, subject to current stock and store limits.", {
+  maximum: Number.MAX_SAFE_INTEGER,
+});
+const key = s.nonEmptyString("Item key returned by this cart.");
+const code = s.nonEmptyString("Coupon code to apply or remove.");
+
+function action(
+  name: string,
+  description: string,
+  fields: Record<string, JsonSchema>,
+  required: string[],
+  checkout = false,
+): ProviderActionDefinition {
+  return defineProviderAction("woocommerce", {
+    name,
+    description,
+    inputSchema: s.actionInput(fields, required),
+    outputSchema: s.actionOutput({
+      cartToken,
+      [checkout ? "checkout" : "cart"]: s.unknownObject(
+        checkout
+          ? "Provider checkout response. order_id zero is not a persisted order. payment_result success alone does not prove payment. Contains private customer/order capabilities."
+          : "Provider cart response, including current items, integer-string minor-unit totals, currency, addresses, available shipping rates and payment methods. Contains private shopper data.",
+      ),
+    }),
+  });
+}
+
+export const woocommerceStoreActions: ProviderActionDefinition[] = [
+  action(
+    "create_cart",
+    "Create a new isolated guest cart. Persist its secret capability before further work. Creation is not idempotent; do not automatically repeat an uncertain call.",
+    {},
+    [],
+  ),
+  action(
+    "get_cart",
+    "Read one existing cart by its secret capability. Invalid or expired capabilities must not silently select a new cart.",
+    { cartToken },
+    ["cartToken"],
+  ),
+  action(
+    "add_cart_item",
+    "Add a product or variation to this cart. Repeating this call can increase quantity; reconcile uncertain calls first.",
+    {
+      cartToken,
+      productId: s.positiveInteger("Product or variation ID."),
+      quantity,
+      variation: s.array(
+        "Chosen variation attributes.",
+        s.object("Attribute selection.", {
+          attribute: s.nonEmptyString("Attribute name."),
+          value: s.nonEmptyString("Selected value."),
+        }),
+      ),
+    },
+    ["cartToken", "productId", "quantity"],
+  ),
+  action(
+    "update_cart_item",
+    "Set the quantity of an existing cart item. Read the returned totals before checkout.",
+    { cartToken, key, quantity },
+    ["cartToken", "key", "quantity"],
+  ),
+  action("remove_cart_item", "Remove an existing item from this cart.", { cartToken, key }, ["cartToken", "key"]),
+  action(
+    "apply_cart_coupon",
+    "Apply a coupon under current store rules and return recalculated totals.",
+    { cartToken, code },
+    ["cartToken", "code"],
+  ),
+  action("remove_cart_coupon", "Remove a coupon and return recalculated totals.", { cartToken, code }, [
+    "cartToken",
+    "code",
+  ]),
+  action(
+    "update_cart_customer",
+    "Set shopper billing/shipping details for this cart and recalculate tax and shipping. Does not authenticate or link a merchant customer account.",
+    {
+      cartToken,
+      billingAddress: address,
+      shippingAddress: address,
+    },
+    ["cartToken"],
+  ),
+  action(
+    "select_cart_shipping_rate",
+    "Select one of the rates returned by this cart for its package. Recalculate and confirm totals afterward.",
+    {
+      cartToken,
+      packageId: s.nonNegativeInteger("Package ID returned by this cart."),
+      rateId: s.nonEmptyString("Rate ID returned for this package."),
+    },
+    ["cartToken", "packageId", "rateId"],
+  ),
+  action(
+    "get_checkout",
+    "Read this cart's checkout state. Some store versions create or update a draft order, so treat this as consequential. A draft order ID can be zero.",
+    { cartToken },
+    ["cartToken"],
+    true,
+  ),
+  action(
+    "submit_checkout",
+    "Submit this cart using a configured payment method that needs no additional payment data. Requires the shopper-confirmed maximum total in minor units. May create an order or initiate payment; never blindly retry. Read provider order/payment status afterward. Does not accept card details or create customer accounts.",
+    {
+      cartToken,
+      billingAddress: address,
+      shippingAddress: address,
+      paymentMethod: s.nonEmptyString(
+        "Enabled provider payment method, such as bacs. Gateway-specific payment data is not supported.",
+      ),
+      expectedTotal: s.string(
+        "Shopper-confirmed maximum total in currency minor units, from cart.totals.total_price. WooCommerce 11.1 rejects increases but permits decreases.",
+        { pattern: "^(0|[1-9][0-9]*)$", maxLength: 30 },
+      ),
+      customerNote: s.string("Shopper note for this order.", { maxLength: 2000 }),
+    },
+    ["cartToken", "paymentMethod", "expectedTotal", "billingAddress", "shippingAddress"],
+    true,
+  ),
+];
diff --git a/src/providers/woocommerce/store-api.test.ts b/src/providers/woocommerce/store-api.test.ts
