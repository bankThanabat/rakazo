+import type { OAuthProviderContext } from "../provider-runtime.ts";
+import type { Schema } from "@cfworker/json-schema";
+
+import { Validator } from "@cfworker/json-schema";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { validateActionInput } from "../../core/validation.ts";
+import { instagramActions } from "./actions.ts";
+import { instagramActionHandlers } from "./runtime.ts";
+
+beforeAll(() =>
+  vi.stubGlobal("fetch", () => {
+    throw new Error("Unexpected network access");
+  }),
+);
+afterAll(() => vi.unstubAllGlobals());
+const context = (fetcher: OAuthProviderContext["fetcher"]): OAuthProviderContext => ({
+  accessToken: "synthetic-token",
+  accountId: "professional-id",
+  fetcher,
+});
+const actions = ["list_conversations", "list_conversation_messages", "get_message"] as const;
+const inputs = {
+  list_conversations: {},
+  list_conversation_messages: { conversationId: "conversation" },
+  get_message: { messageId: "message" },
+};
+const paths = {
+  list_conversations: "/v25.0/professional-id/conversations",
+  list_conversation_messages: "/v25.0/conversation/messages",
+  get_message: "/v25.0/message",
+};
+const fields = {
+  list_conversations: "id,updated_time",
+  list_conversation_messages: "id,created_time",
+  get_message: "id,created_time,from,to,message",
+};
+
+describe("Instagram message history reads", () => {
+  it.each(actions)("%s returns valid declared output for Meta's raw timestamp form", async (name) => {
+    const action = instagramActions.find((item) => item.name === name)!;
+    const timestamp = "2026-09-19T00:00:00+0000";
+    // The upstream validator accepts this non-RFC3339 form even with date-time.
+    // Keep the catalog honest for clients whose format validation is stricter.
+    expect(JSON.stringify(action.outputSchema)).not.toContain('"format":"date-time"');
+    const payload =
+      name === "get_message"
+        ? {
+            id: "message",
+            created_time: timestamp,
+            from: { id: "professional-id" },
+            to: { data: [{ id: "customer-scoped-id" }] },
+            message: "Hello",
+          }
+        : { data: [{ id: "reference", created_time: timestamp, updated_time: timestamp }] };
+    const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockResolvedValue(Response.json(payload));
+    const output = await instagramActionHandlers[name](inputs[name], context(fetcher));
+    expect(new Validator(action.outputSchema as Schema).validate(output)).toMatchObject({ valid: true });
+    expect(JSON.stringify(output)).toContain(timestamp);
+  });
+  it.each(actions)("%s has message permissions and rejects arbitrary request input", (name) => {
+    const action = instagramActions.find((item) => item.name === name)!;
+    expect(action.requiredScopes).toEqual(["instagram_business_basic", "instagram_business_manage_messages"]);
+    expect(validateActionInput(action, inputs[name]).valid).toBe(true);
+    expect(validateActionInput(action, { ...inputs[name], method: "POST" }).valid).toBe(false);
+    if (name !== "list_conversations") expect(validateActionInput(action, {}).valid).toBe(false);
+    if (name !== "get_message")
+      for (const extra of [{ limit: 21 }, { limit: 0 }, { limit: 1.5 }, { after: "a", before: "b" }])
+        expect(validateActionInput(action, { ...inputs[name], ...extra }).valid).toBe(false);
+  });
+
+  it.each(actions)("%s issues exactly one fixed GET, ignoring handler-level HTTP overrides", async (name) => {
+    const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockImplementation(async (target, init) => {
+      const url = new URL(String(target));
+      expect(url.origin).toBe("https://graph.instagram.com");
+      expect(url.pathname).toBe(paths[name]);
+      expect(url.searchParams.get("fields")).toBe(fields[name]);
+      expect(url.searchParams.get("platform")).toBe(name === "list_conversations" ? "instagram" : null);
+      expect(url.searchParams.get("limit")).toBe(name === "get_message" ? null : "20");
+      expect(url.searchParams.has("access_token")).toBe(false);
+      expect(init?.method).toBe("GET");
+      expect(init?.body).toBeUndefined();
+      expect(new Headers(init?.headers).get("authorization")).toBe("Bearer synthetic-token");
+      return Response.json(name === "get_message" ? { id: "message" } : { data: [] });
+    });
+    await instagramActionHandlers[name](
+      {
+        ...inputs[name],
+        accountId: "other-account",
+        method: "POST",
+        fields: "attachments",
+        endpoint: "https://untrusted.example.test",
+        body: { text: "send" },
+      },
+      context(fetcher),
+    );
+    expect(fetcher).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(["list_conversations", "list_conversation_messages"] as const)(
+    "%s retains empty and short page cursors without exposing URLs",
+    async (name) => {
+      const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockImplementation(async (target) => {
+        const url = new URL(String(target));
+        if (!url.searchParams.has("after"))
+          return Response.json({
+            data: [],
+            paging: { next: "https://untrusted.example.test/?access_token=private", cursors: { after: "page-2" } },
+          });
+        expect(url.searchParams.get("after")).toBe("page-2");
+        return Response.json({
+          data: [
+            { id: "reference", created_time: "2026-09-19T00:00:00+0000", updated_time: "2026-09-19T00:00:00+0000" },
+          ],
+        });
+      });
+      const first = await instagramActionHandlers[name](inputs[name], context(fetcher));
+      expect(first).toMatchObject({ paging: { after: "page-2", hasNextPage: true } });
+      expect(JSON.stringify(first)).not.toContain("private");
+      const second = await instagramActionHandlers[name]({ ...inputs[name], after: "page-2" }, context(fetcher));
+      expect(second).toEqual({
+        [name === "list_conversations" ? "conversations" : "messages"]: [
+          {
+            id: "reference",
+            [name === "list_conversations" ? "updatedTime" : "createdTime"]: "2026-09-19T00:00:00+0000",
+          },
+        ],
+        paging: { hasNextPage: false, hasPreviousPage: false },
+      });
+    },
+  );
+
+  it("preserves inbound and outbound identities and text without inventing human authorship", async () => {
+    for (const [sender, recipient] of [
+      ["customer-scoped-id", "professional-id"],
+      ["professional-id", "customer-scoped-id"],
+    ]) {
+      const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockResolvedValue(
+        Response.json({
+          id: "message",
+          created_time: "2026-09-19T00:00:00+0000",
+          message: "  สวัสดีค่ะ\nHello  ",
+          from: { id: sender, username: "same-name" },
+          to: { data: [{ id: recipient, username: "same-name" }] },
+          is_echo: true,
+          is_self: true,
+          author_role: "staff",
+          attachments: { data: [{ url: "https://private.example.test" }] },
+        }),
+      );
+      expect(await instagramActionHandlers.get_message(inputs.get_message, context(fetcher))).toEqual({
+        message: {
+          id: "message",
+          createdTime: "2026-09-19T00:00:00+0000",
+          text: "  สวัสดีค่ะ\nHello  ",
+          from: { id: sender, username: "same-name" },
+          to: [{ id: recipient, username: "same-name" }],
+        },
+      });
+    }
+  });
+
+  it("keeps missing text and unknown identities absent instead of inferring them from names", async () => {
+    const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockResolvedValue(
+      Response.json({
+        id: "message",
+        from: { id: 123, username: "business" },
+        to: { data: [{ username: "business" }] },
+      }),
+    );
+    expect(await instagramActionHandlers.get_message(inputs.get_message, context(fetcher))).toEqual({
+      message: { id: "message", to: [] },
+    });
+  });
+
+  it.each([400, 403, 404, 429])("keeps HTTP %i, including old-message errors, as a failure", async (status) => {
+    for (const name of actions) {
+      const fetcher = vi
+        .fn<OAuthProviderContext["fetcher"]>()
+        .mockResolvedValue(Response.json({ error: { message: "Unavailable or deleted" } }, { status }));
+      await expect(instagramActionHandlers[name](inputs[name], context(fetcher))).rejects.toMatchObject({ status });
+      expect(fetcher).toHaveBeenCalledTimes(1);
+    }
+  });
+
+  it.each([{}, { data: null }, { data: [{}] }, { data: [], paging: { next: "https://example.test/next" } }])(
+    "rejects malformed pages instead of claiming completion: %j",
+    async (payload) => {
+      for (const name of ["list_conversations", "list_conversation_messages"] as const) {
+        const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockResolvedValue(Response.json(payload));
+        await expect(instagramActionHandlers[name](inputs[name], context(fetcher))).rejects.toThrow();
+      }
+    },
+  );
+
+  it.each([{}, { id: "different" }, { id: "message", to: { data: "bad" } }])(
+    "rejects malformed or substituted message details: %j",
+    async (payload) => {
+      const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockResolvedValue(Response.json(payload));
+      await expect(instagramActionHandlers.get_message(inputs.get_message, context(fetcher))).rejects.toThrow();
+    },
+  );
+
+  it("encodes opaque conversation and message IDs without changing the host or path shape", async () => {
+    for (const name of ["list_conversation_messages", "get_message"] as const) {
+      const id = "opaque/messages?access_token=other";
+      const fetcher = vi.fn<OAuthProviderContext["fetcher"]>().mockImplementation(async (target) => {
+        const url = new URL(String(target));
+        expect(url.origin).toBe("https://graph.instagram.com");
+        expect(url.pathname).toBe(
+          `/v25.0/opaque%2Fmessages%3Faccess_token%3Dother${name === "get_message" ? "" : "/messages"}`,
+        );
+        expect(url.searchParams.has("access_token")).toBe(false);
+        return Response.json(name === "get_message" ? { id } : { data: [] });
+      });
+      await instagramActionHandlers[name](
+        { [name === "get_message" ? "messageId" : "conversationId"]: id },
+        context(fetcher),
+      );
+    }
+  });
+
+  it("rejects invalid page limits, missing IDs and conflicting cursors before I/O", async () => {
+    const fetcher = vi.fn<OAuthProviderContext["fetcher"]>();
+    for (const name of ["list_conversations", "list_conversation_messages"] as const)
+      for (const extra of [{ limit: 21 }, { limit: 0 }, { limit: "20" }, { after: "a", before: "b" }])
+        await expect(instagramActionHandlers[name]({ ...inputs[name], ...extra }, context(fetcher))).rejects.toThrow();
+    await expect(instagramActionHandlers.get_message({}, context(fetcher))).rejects.toThrow();
+    await expect(instagramActionHandlers.list_conversation_messages({}, context(fetcher))).rejects.toThrow();
+    await expect(
+      instagramActionHandlers.list_conversations({}, { ...context(fetcher), accountId: undefined }),
+    ).rejects.toThrow();
+    expect(fetcher).not.toHaveBeenCalled();
+  });
+});
