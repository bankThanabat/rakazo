+@pytest.mark.asyncio
+async def test_knowledge_requires_explicit_sources_and_rbac(monkeypatch):
+    from types import SimpleNamespace
+    from fastapi import HTTPException
+    from api.v1 import customer_flows as api
+
+    monkeypatch.setattr(api, "is_rbac_enforced", lambda: False)
+    with pytest.raises(HTTPException) as error:
+        api.require_customer_rbac()
+    assert error.value.status_code == 503
+    monkeypatch.setattr(api, "resolve_filter_id", AsyncMock(return_value={"filters": {}}))
+    user = SimpleNamespace(user_id="owner", jwt_token="fake")
+    with pytest.raises(HTTPException) as error:
+        await api.approved_filter("filter", None, user)
+    assert error.value.status_code == 422
+    monkeypatch.setattr(
+        api,
+        "resolve_filter_id",
+        AsyncMock(return_value={"filters": {"data_sources": ["public-source"]}}),
+    )
+    assert (await api.approved_filter("filter", None, user))["filters"]["data_sources"] == [
+        "public-source"
+    ]
