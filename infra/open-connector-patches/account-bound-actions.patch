+    expect(response.status).toBe(409);
+    expect((await response.json()).meta).not.toHaveProperty("dispatch");
+    expect(f.execute).toHaveBeenCalledOnce();
+  });
+  it("keeps runtime authentication and account input bounds on the new endpoint", async () => {
+    const f = await fixture();
+    expect((await f.send(f.account, undefined, "Bearer invalid")).status).toBe(401);
+    expect((await f.send("x".repeat(501))).status).toBe(400);
+    expect(f.execute).not.toHaveBeenCalled();
+    const document = (await (
+      await f.app.request("/openapi.json", { headers: { authorization: "Bearer synthetic-admin" } })
+    ).json()) as { paths: Record<string, { post?: { parameters: unknown[] }; get?: unknown }> };
+    const path = document.paths["/v1/actions/{actionId}/for-account/{accountId}"];
+    expect(path?.get).toBeUndefined();
+    expect(path?.post?.parameters).toContainEqual(
+      expect.objectContaining({ name: "accountId", in: "path", required: true }),
