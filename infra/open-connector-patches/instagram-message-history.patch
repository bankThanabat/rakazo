+/** One fixed GET per call; never follow provider paging URLs containing credentials. */
+async function listMessagingEdge(
+  input: Record<string, unknown>,
+  context: OAuthProviderContext,
+  parentId: string,
+  edge: "conversations" | "messages",
+): Promise<Record<string, unknown>> {
+  assertExclusiveCursors(input);
+  const limit = input.limit ?? 20;
+  if (typeof limit !== "number" || !Number.isInteger(limit) || limit < 1 || limit > 20)
+    throw providerInputError("limit must be an integer between 1 and 20");
+  const payload = requiredRecord(
+    await instagramRequestJson(
+      {
+        path: `/${encodePathSegment(parentId)}/${edge}`,
+        query: {
+          fields: edge === "conversations" ? "id,updated_time" : "id,created_time",
+          platform: edge === "conversations" ? "instagram" : undefined,
+          after: optionalString(input.after),
+          before: optionalString(input.before),
+          limit: String(limit),
+        },
+      },
+      context,
+    ),
+    "Instagram messaging page",
+    providerResponseError,
+  );
+  const paging = normalizePaging(payload.paging);
+  if ((paging.hasNextPage && !paging.after) || (paging.hasPreviousPage && !paging.before))
+    throw providerResponseError("Instagram messaging page omitted its cursor");
+  return {
+    [edge]: objectArray(payload.data, "Instagram messaging references", providerResponseError).map((item) =>
+      compactObject({
+        id: requiredString(item.id, "Instagram messaging reference ID", providerResponseError),
+        ...(edge === "conversations"
+          ? { updatedTime: optionalString(item.updated_time) }
+          : { createdTime: optionalString(item.created_time) }),
+      }),
+    ),
+    paging,
+  };
+}
+
+function messageParticipant(value: unknown): Record<string, unknown> | undefined {
+  const participant = optionalRecord(value);
+  const id = optionalString(participant?.id);
+  return id ? compactObject({ id, username: optionalString(participant?.username) }) : undefined;
+}
+
+async function getMessage(
+  input: Record<string, unknown>,
+  context: OAuthProviderContext,
+): Promise<Record<string, unknown>> {
+  const messageId = requiredString(input.messageId, "messageId", providerInputError);
+  const payload = requiredRecord(
+    await instagramRequestJson(
+      { path: `/${encodePathSegment(messageId)}`, query: { fields: "id,created_time,from,to,message" } },
+      context,
+    ),
+    "Instagram message",
+    providerResponseError,
+  );
+  const id = requiredString(payload.id, "Instagram message ID", providerResponseError);
+  if (id !== messageId) throw providerResponseError("Instagram returned a different message ID");
+  const recipients = optionalRecord(payload.to);
+  return {
+    message: compactObject({
+      id,
+      createdTime: optionalString(payload.created_time),
+      text: optionalRawString(payload.message),
+      from: messageParticipant(payload.from),
+      to:
+        recipients?.data === undefined
+          ? undefined
+          : objectArray(recipients.data, "Instagram message recipients", providerResponseError).flatMap((item) => {
+              const participant = messageParticipant(item);
+              return participant ? [participant] : [];
+            }),
+    }),
+  };
+}
